{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Squeezer",
  "version": "1.1.1",
  "identifier": "com.squeezer.local",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Squeezer",
        "width": 1120,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "resources/squeezer-video-helper": "squeezer-video-helper"
    },
    "icon": [
      "icons/icon.png"
    ],
    "category": "public.app-category.utilities"
  }
}
